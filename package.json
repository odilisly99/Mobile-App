    "@types/express": "^4.17.13",
    "@types/jest": "^27.0.2",
    "@types/node": "^24.1.0",
    "@wdio/allure-reporter": "^9.19.2",
    "@wdio/appium-service": "^9.19.2",
    "@wdio/cli": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "appium-uiautomator2-driver": "^5.0.0",
    "appium-xcuitest-driver": "^10.2.1",
    "jest": "^27.0.6",
