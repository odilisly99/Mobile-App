{
  "name": "mobile-automation-copilot-agent",
  "version": "1.0.0",
  "description": "",
  "main": "wdio.conf.js",
  "files": [
    "device_farms_tests/",
    "wdio.conf.js",
    "package.json"
  ],
  "scripts": {
    "test": "wdio run ./wdio.suite.conf.js",
    "wdio": "wdio run ./wdio.conf.js",
    "wdio:ios": "wdio run ./wdio.ios.conf.js",
    "wdio:suite": "wdio run ./wdio.suite.conf.js",
    "test:mobile": "wdio run ./wdio.conf.js",
    "test:hybrid": "wdio run ./wdio.conf.js --spec ./tests/specs/*_with_admin.spec.js",
    "test:example": "wdio run ./wdio.conf.js --spec ./tests/specs/hybrid_example.spec.js",
    "test:original": "wdio run ./wdio.conf.js --spec ./tests/specs/test1.spec.js",
    "benchmark": "node benchmark.js",
    "benchmark:quick": "node benchmark.js --quick",
    "allure:report:custom": "allure generate allure-results --clean -o allure-report --name 'MobileAutomationReport'",
    "allure:report:android:custom": "allure generate ./allure-results-android --clean -o ./allure-report-android --name 'MobileAutomationReport'",
    "allure:report:ios:custom": "allure generate ./allure-results-ios --clean -o ./allure-report-ios --name 'MobileAutomationReport'",
    "discover:suites": "node scripts/discover-test-suites.js list",
    "discover:matrix": "node scripts/discover-test-suites.js matrix",
    "validate:setup": "node scripts/validate-setup.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "appium": "^3.1.0",
    "body-parser": "^1.19.0",
